# Generated by an Aether agent. Risk level R2, bordering R3.
# Request: "put a Postgres on here, only reachable from this machine"
#
# R2 rather than R3 because it opens no firewall port. Had the request been
# "reachable from my laptop", it would be R3: the hardened protocol, a rollback
# timer, and an explicit yes before switching.
#
# Rename without .example to actually use it.

{ config, pkgs, ... }:

{
  services.postgresql = {
    enable = true;
    package = pkgs.postgresql_16;

    # Loopback only. No firewall change, so nothing new is exposed.
    enableTCPIP = false;

    authentication = ''
      local all all peer
    '';
  };

  services.postgresqlBackup = {
    enable = true;
    startAt = "*-*-* 03:00:00";
  };
}
